# Copy to .env.local for local development, or set in Vercel project settings.
#
# Everything here degrades gracefully when unset EXCEPT ADMIN_PASSWORD, which
# fails closed — an admin page with no password must not be world-readable.

# --- Email (Resend) -------------------------------------------------------
# Replaces PHPMailer/SMTP:25, which is blocked on Vercel's serverless runtime.
# The sending domain must be verified in Resend or delivery fails SILENTLY.
RESEND_API_KEY=
# Verified sender, e.g. "Hound Away From Home <noreply@houndawayfromhome.com>"
MAIL_FROM=
# Where form submissions are delivered.
CONTACT_US_EMAIL=
CONTACT_US_NAME=

# --- reCAPTCHA v3 ---------------------------------------------------------
# Unset => the check is skipped with a warning (so local dev works).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score to accept, 0.0-1.0. Default 0.5.
# The PHP checked only `success`, which for v3 is true for ANY valid token
# regardless of score — so it had no real bot protection.
RECAPTCHA_MIN_SCORE=0.5

# --- HubSpot --------------------------------------------------------------
# Unset => contact upsert is a no-op, matching the PHP's behavior.
HUBSPOT_API_TOKEN=

# --- Vercel Blob (lead storage) -------------------------------------------
# On Vercel, auth comes from an auto-rotating OIDC token and this is NOT needed.
# Locally, run `vercel env pull` to obtain one.
BLOB_READ_WRITE_TOKEN=

# --- Admin ----------------------------------------------------------------
# Shared password for /admin/leads (HTTP Basic; any username). REQUIRED —
# unset means /admin returns 401 for everyone.
ADMIN_PASSWORD=

# --- Spam / abuse ---------------------------------------------------------
# Comma-separated substrings that mark a submission as spam. Seeded with the one
# string the PHP hardcoded.
SPAM_SUBSTRINGS=serviseantilogin
# Comma-separated email addresses to silently reject.
EMAIL_DISALLOW_LIST=

# --- Analytics ------------------------------------------------------------
# Both already public in the shipped PHP <head>; not secrets.
NEXT_PUBLIC_GA_ID=G-FRD4XKQCPT
NEXT_PUBLIC_FB_PIXEL_ID=1217184416699830
# Set to "debug" on a preview deploy to force analytics on for verification.
# The PHP gated on STAGE, which made pixel parity impossible to check on staging.
NEXT_PUBLIC_ANALYTICS_MODE=
