# Refuse package versions published less than a week ago.
#
# NOTE THE UNIT: npm's `min-release-age` is in DAYS. Bun's equivalent in
# bunfig.toml (`minimumReleaseAge`) is in SECONDS. Both are set to one week;
# keep them in step, along with `cooldown` in .github/dependabot.yml.
#
# Why a week: compromised-maintainer attacks on npm (chalk/debug, and the
# self-propagating Shai-Hulud waves) are found and unpublished within
# hours-to-days. A week of quarantine means the ecosystem finds the malicious
# version before this project installs it. The cost is lagging legitimate
# releases by a week, which a marketing site can absorb.
#
# `min-release-age` is mutually exclusive with `before` — setting both errors.
# It needs a recent npm (verified on 11.11.0). An npm too old to know the key
# ignores it, so the failure mode is losing the protection, not a broken build.
min-release-age=7
